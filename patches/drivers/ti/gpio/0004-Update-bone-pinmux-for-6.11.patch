 drivers/misc/cape/beaglebone/bone-pinmux-helper.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)
 mode change 100644 => 100755 drivers/misc/cape/beaglebone/bone-pinmux-helper.c

diff --git a/drivers/misc/cape/beaglebone/bone-pinmux-helper.c b/drivers/misc/cape/beaglebone/bone-pinmux-helper.c
old mode 100644
new mode 100755
index 57703d8bcac7..11c271d2cdd0
