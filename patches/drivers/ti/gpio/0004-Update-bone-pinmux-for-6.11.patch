 	struct pinmux_helper_data *data = platform_get_drvdata(pdev);
 	struct device *dev = &pdev->dev;
@@ -220,8 +222,6 @@ static int bone_pinmux_helper_remove(struct platform_device *pdev)
 	kfree(data->selected_state_name);
